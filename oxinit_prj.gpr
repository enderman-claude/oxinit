project Oxinit_Prj is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("oxinit_main.adb", "oxictl_main.adb");

   package Builder is
      for Executable ("oxinit_main.adb") use "oxinit";
      for Executable ("oxictl_main.adb") use "oxictl";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-O2", "-g");
   end Compiler;

   package Linker is
      --  The VM image copies the shared libraries these binaries need (see test/vm).
      --  memeunit is compiled in as a static archive. libshard (vendor/shard) reads and
      --  converts SHARD service binaries; build it with make -C vendor/shard build/libshard.a.
      for Default_Switches ("Ada") use ("memeunit/libmemeunit.a", "vendor/shard/build/libshard.a");
   end Linker;

end Oxinit_Prj;

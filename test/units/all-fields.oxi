# Unit file: every field, every mood, every furry species.
# Used by test.sh with --check, so it must always pass. Nothing here is
# started by the test suite. Each service name is unique. See README.md, Syntax.

# --- Furry section -----------------------------------------------------------
# Recognised species (matched case-insensitively): protogen (proto), wolf, fox, dragon, spy.
# Anything else uses the generic meme pool.

@furry-protogen
!mood                owo
!summon              /bin/sh
!incant              -c 'sleep 1; exit 0'
!arena               /
!role                root
!party               root
!loadout             FURSONA=protogen VISOR=on
!lives               on-failure
!cooldown            1s
!eviction-notice     HUP
!grace               3s
!scoreboard          -
!amiafurry           true
!fursona-name        Visor
!fursona-description A protogen who keeps the visor on.
!fursona-species     Protogen

@furry-wolf
!mood                feral
!summon              /bin/sh
!incant              -c 'echo "howl at the moon"'
!arena               /
!role                root
!party               root
!loadout             -
!lives               always
!cooldown            2s
!eviction-notice     INT
!grace               2s
!scoreboard          -
!amiafurry           true
!fursona-name        Kestrel
!fursona-description A silver wolf who guards the web server.
!fursona-species     wolf

@furry-fox
!mood                sus
!summon              /bin/sh
!incant              -c 'echo fox'
!arena               /
!role                root
!party               root
!loadout             -
!lives               never
!cooldown            0s
!eviction-notice     QUIT
!grace               1s
!scoreboard          -
!amiafurry           true
!fursona-name        Ember
!fursona-description A quick red fox who never stays long.
!fursona-species     fox

@furry-dragon
!mood                blessed
!summon              /bin/sh
!incant              -c 'echo breathing'
!arena               /
!role                root
!party               root
!loadout             -
!lives               always
!cooldown            3s
!eviction-notice     USR1
!grace               4s
!scoreboard          -
!amiafurry           true
!fursona-name        Sable
!fursona-description A dragon who sleeps on the hoard.
!fursona-species     Dragon

@furry-spy
!mood                sus
!summon              /bin/sh
!incant              -c 'echo not really a furry'
!arena               /
!role                root
!party               root
!loadout             -
!lives               always
!cooldown            1s
!eviction-notice     TERM
!grace               2s
!scoreboard          -
!amiafurry           true
!fursona-name        Agent Tail
!fursona-description A spy in a fursuit. The tail is taped on.
!fursona-species     Spy

@furry-axolotl
!mood                hyper
!summon              /bin/sh
!incant              -c 'echo regenerating'
!arena               /
!role                root
!party               root
!loadout             -
!lives               always
!cooldown            1s
!eviction-notice     USR2
!grace               2s
!scoreboard          -
!amiafurry           true
!fursona-name        Pip
!fursona-description An axolotl. Not on the species list, so generic lines.
!fursona-species     axolotl

@furry-off
!mood                chill
!summon              /bin/sh
!incant              -c 'echo not a furry'
!arena               /
!role                root
!party               root
!loadout             -
!lives               always
!cooldown            1s
!eviction-notice     TERM
!grace               2s
!scoreboard          -
!amiafurry           false
!fursona-name        -
!fursona-description -
!fursona-species     -


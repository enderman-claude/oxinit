# --- Argument quoting and environment ----------------------------------

@quoting
!mood                chill
!summon              /bin/sh
!incant              -c 'echo "two words" && echo \"nested\"'
!arena               /
!role                root
!party               root
!loadout             A=1 B=two
!lives               always
!cooldown            1s
!eviction-notice     TERM
!grace               5s
!scoreboard          /tmp/oxinit-unit-quoting.log
!amiafurry           false
!fursona-name        -
!fursona-description -
!fursona-species     -

@empty-loadout
!mood                sleepy
!summon              /bin/sh
!incant              -
!arena               /
!role                root
!party               root
!loadout             -
!lives               never
!cooldown            0s
!eviction-notice     TERM
!grace               1s
!scoreboard          -
!amiafurry           false
!fursona-name        -
!fursona-description -
!fursona-species     -
